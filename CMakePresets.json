
{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "hps-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/matrix/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc-base",
      "hidden": true,
      "inherits": "hps-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "clang-base",
      "hidden": true,
      "inherits": "hps-base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "gcc-c89",
      "inherits": "gcc-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "90"
      }
    },
    {
      "name": "clang-c89",
      "inherits": "clang-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "90"
      }
    },
    {
      "name": "gcc-c99",
      "inherits": "gcc-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "99"
      }
    },
    {
      "name": "clang-c99",
      "inherits": "clang-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "99"
      }
    },
    {
      "name": "gcc-c11",
      "inherits": "gcc-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "11"
      }
    },
    {
      "name": "clang-c11",
      "inherits": "clang-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "11"
      }
    },
    {
      "name": "gcc-c17",
      "inherits": "gcc-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "17"
      }
    },
    {
      "name": "clang-c17",
      "inherits": "clang-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "17"
      }
    },
    {
      "name": "gcc-c23",
      "inherits": "gcc-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "23"
      }
    },
    {
      "name": "clang-c23",
      "inherits": "clang-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "23"
      }
    },

    {
      "name": "gcc-sanitized",
      "displayName": "HPS GCC C89 Sanitized",
      "inherits": "gcc-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "90",
        "HPS_BUILD_PROFILE": "SANITIZED",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-sanitized",
      "displayName": "HPS Clang C89 Sanitized",
      "inherits": "clang-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "90",
        "HPS_BUILD_PROFILE": "SANITIZED",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "HPS GCC C89 Release",
      "inherits": "gcc-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "90",
        "HPS_BUILD_PROFILE": "RELEASE",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang-release",
      "displayName": "HPS Clang C89 Release",
      "inherits": "clang-base",
      "cacheVariables": {
        "HPS_C_STANDARD": "90",
        "HPS_BUILD_PROFILE": "RELEASE",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }

  ]
}
